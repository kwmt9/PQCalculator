@using System.Text.Json
@using PQCalculator.Logic
@using PQCalculator.Model
@inject HttpClient Http
@page "/"
<PageTitle>パワクエコーチ計算機(仮)</PageTitle>
<div>
    <NavMenu Title="パワクエコーチ計算機(仮)" />
</div>
<div class="container d-flex flex-column align-items-center width-clamp">
    <div class="mb-3">
        <Collapse Title="説明">
            <ol>
                <li>契約書キャラを入力する</li>
                <li>コーチ人数を入力</li>
                <li>計算開始を押す</li>
                <li>持ってないキャラはバツを押す</li>
            </ol>
            <ul>
                <li>上限はPSR覚醒の値です。ない場合は消してください。</li>
                <li>同じキャラがいる場合はどちらかを消してください。</li>
            </ul>
        </Collapse>
    </div>
    @if (EventUnits != null) {
        <div class="mb-3">
            <AutoCompleteInput @ref="AutoCompleteInput" StringList="Suggest" Placeholder="契約書キャラ選択" TextChanged="@((s) => GetUnitStatus())"></AutoCompleteInput>
        </div>
        <h3>契約書能力設定</h3>
        if (Unit != null) {
            <PlayerPositionComponent Position="Unit.Position"></PlayerPositionComponent>
            <AbilityListComponent Abilitys="Unit.Abilities"></AbilityListComponent>
            <div class="mb-2"></div>
        }
        <div id="calculationForm">
            <div class="input-group mb-2">
                <SpinnerInput Label="コーチ人数" Min="0" Max="4" InputValue="@CoarchCount" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} CoarchCount = o;})"></SpinnerInput>
            </div>
        </div>
        <div class="mb-2 d-flex flex-column align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="check1" @onchange='(e) => {isSubPosition = (bool)e.Value; GetUnitStatus();}'>
                <label class="form-check-label" for="check1" style="user-select: none;">
                    サブポジ運用  
                </label>  
            </div>
            @if (isSubPosition) {
                <div class="d-flex">
                    <div class="form-check px-1">
                        <input class="form-check-input mx-1 " type="radio" id="sub-radio-0" name="sub-pos" value="0" @onchange="(e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} SelectedSubpos = o;GetUnitStatus();CaluculateCoach();}">
                        <label class="form-check-label" for="sub-radio-0" style="user-select: none;">
                            サブポジ
                        </label>
                    </div>

                    <div class="form-check px-1">
                        <input class="form-check-input mx-1" type="radio" id="sub-radio-1" name="sub-pos" value="1" @onchange="(e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} SelectedSubpos = o;GetUnitStatus();CaluculateCoach();}">
                        <label class="form-check-label" for="sub-radio-1" style="user-select: none;">
                            サブポジ〇
                        </label>
                    </div>

                    <div class="form-check px-1">
                        <input class="form-check-input mx-1" type="radio" id="sub-radio-2" name="sub-pos" value="2" @onchange="(e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} SelectedSubpos = o;GetUnitStatus();CaluculateCoach();}">
                        <label class="form-check-label" for="sub-radio-2" style="user-select: none;">
                            サブポジ◎
                        </label>
                    </div>
                </div>
            }
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="check2" @onchange='(e) => {isBench = (bool)e.Value; CaluculateCoach();}'>
                <label class="form-check-label" for="check2" style="user-select: none;">
                    ベンチ運用  
                </label>  
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="check4" @onchange='(e) => {isJukuren = (bool)e.Value; SelectJukurenIndexes=new();}'>
                <label class="form-check-label" for="check4" style="user-select: none;">
                    熟練の〇〇持ち
                </label>
            </div>
            @if (isJukuren) {
                <div class="d-flex row">
                    @for(int i = 0;i < JukurenInfos.Count;i++){
                        int index = i;
                        var jukurenInfo = JukurenInfos[index];

                        <div class="form-check px-1 col-3">
                            <input class="form-check-input mx-1 " type="checkbox" id="@($"sub-radio-{index}")" name="jukuren" @onchange="(e) => { if((bool)e.Value == true){SelectJukurenIndexes.Add(index);}else{SelectJukurenIndexes.Remove(index);};}">
                            <label class="form-check-label" for="@($"sub-radio-{index}")" style="user-select: none;">
                                @jukurenInfo.Name
                            </label>
                        </div>
                    }
                </div>
            }
            <div class="form-check">  
                <input class="form-check-input" type="checkbox" id="check3" @onchange='(e) => {isCalucSatei = (bool)e.Value;}'>
                <label class="form-check-label" for="check3" style="user-select: none;">
                    査定を計算  
                </label>  
            </div>  
        </div>  

        @if (isCalucSatei)
        {
            <div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="契約書Lv" Min="1" Max="999" InputValue="@Level" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;}; Level = o;GetUnitStatus();})"></SpinnerInput>
                </div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="ミート" Min="1" Max="999" InputValue="@InputStatus.Meet" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.Meet = o;})"></SpinnerInput>
                </div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="パワー" Min="1" Max="999" InputValue="@InputStatus.Power" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.Power = o;})"></SpinnerInput>
                </div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="走力" Min="1" Max="999" InputValue="@InputStatus.RunPower" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.RunPower = o;})"></SpinnerInput>
                </div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="肩力" Min="1" Max="999" InputValue="@InputStatus.ShoulderPower" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.ShoulderPower = o;})"></SpinnerInput>
                </div>
                <div class="input-group mb-1">
                    <SpinnerInput Label="守備力" Min="1" Max="999" InputValue="@InputStatus.Fielding" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.Fielding = o;})"></SpinnerInput>
                </div>
                <div class="input-group mb-2">
                    <SpinnerInput Label="捕球" Min="1" Max="999" InputValue="@InputStatus.Catching" OnInput="@((e) => {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputStatus.Catching = o;})"></SpinnerInput>
                </div>
                @if (Unit?.Position == 1) {
                    <div class="input-group mb-2">
                        <SpinnerInput Label="球速" Min="1" Max="999" InputValue="@InputPitcherStatus.BallSpeed" OnInput="@((e) =>  {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputPitcherStatus.BallSpeed = o;})"></SpinnerInput>
                    </div>
                    <div class="input-group mb-2">
                        <SpinnerInput Label="コン" Min="1" Max="999" InputValue="@InputPitcherStatus.BallControl" OnInput="@((e) =>  {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputPitcherStatus.BallControl = o;})"></SpinnerInput>
                    </div>
                    <div class="input-group mb-2">
                        <SpinnerInput Label="スタ" Min="1" Max="999" InputValue="@InputPitcherStatus.Stamina" OnInput="@((e) =>  {if(!int.TryParse(e.Value?.ToString(),out int o)){return;} InputPitcherStatus.Stamina = o;})"></SpinnerInput>
                    </div>
                }
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="check6" @onchange='(e) => {isFielderMax = (bool)e.Value;}'>
                <label class="form-check-label" for="check6" style="user-select: none;">
                    野手特訓値のコーチ不足分をを最大化
                </label>
            </div>
            @if (Unit?.Position == 1) {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="check5" @onchange='(e) => {isPitcherMax = (bool)e.Value;}'>
                    <label class="form-check-label" for="check5" style="user-select: none;">
                        投手特訓値のコーチ不足分をを最大化
                    </label>
                </div>
            }
        }
        <button @onclick="CaluculateCoach" class="btn btn-primary mb-3">計算開始</button>
    }
</div>
@if (decks != null)
{
    <div class="container d-flex flex-column align-items-center width-clamp">
        @if (Unit != null && isCalucSatei)
        {
            <h3>査定</h3>
            <h4>@(CalucScore())</h4>
            <Collapse Title="内訳">
                <div class="container d-flex flex-column align-items-center width-clamp">
                    @if (sateiInfos.Count > 0)
                    {
                        sateiInfos = sateiInfos.OrderByDescending(x => x.Ability?.SateiMain ?? 100000).ToList();
                        @foreach (var satei in sateiInfos)
                        {
                            <span class="mb-1">
                                @if (satei.Ability != null)
                                {
                                    <AbilityComponent Ability="@satei.Ability"></AbilityComponent>
                                }
                                else
                                {
                                    @satei.Label
                                }
                                : @satei.Score
                            </span>
                        }
                    }
                </div>

            </Collapse>
        }
    </div>
    <div class="d-flex justify-content-center flex-column align-items-center">
        <h3>計算結果</h3>
        @if (Unit?.Position == 1) {
            <StatusComponent FielderStatus="DeckLimit" PitcherStatus="DeckPitcherLimit"></StatusComponent>
        }else {
            <StatusComponent FielderStatus="DeckLimit"></StatusComponent>
        }
    </div>
    <div class="d-flex flex-wrap justify-content-start justify-content-xl-center">

        @for (int i = 0; i < decks.GroupBy(x => x.deckNumber).Count(); i++)
        {
            var deck = decks.GroupBy(x => x.deckNumber).Where(x => x.Key == i);
            <div class="d-inline-flex flex-column col-12 col-lg-6 col-xl-3 align-items-baseline border rounded">
                <h3>デッキ @(i + 1)</h3>
                <div class="mb-3">
                    @foreach (var units in deck.First()) {
                        var unit = units.unit;
                        <div class="px-2" style="display: flex;">
                            <div>
                                @unit.Name
                            </div>
                            <!--
                            <div>@($"{unit.Limit.Meet} {unit.Limit.Power} {unit.Limit.RunPower} {unit.Limit.ShoulderPower} {unit.Limit.Fielding} {unit.Limit.Catching} {unit.Limit.BallControl} {unit.Limit.Stamina}")</div>
                            -->
                            <button type="button" class="btn-close" aria-label="Close" @onclick="() => AddNotOwnedUnit(unit.Id)"></button>
                            <div>
                                @if (units.Ability != null){
                                    <AbilityComponent Ability="@units.Ability"></AbilityComponent>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="mb-3 px-2">
                    @if (deckAbilites != null) {
                        @foreach (var ab in deckAbilites[i]) {
                            <div class="mb-2">
                                <AbilityComponent Ability="@ab"></AbilityComponent>
                                <span class="fw-bold">@(isBench ? ab.SateiSub : ab.SateiMain)</span>
                            </div>
                        }
                    }
                </div>

            </div>
        }
    </div>
}

@if (notOwnedUnits.Count > 0) {
    <Liner></Liner>
    <h3>持ってないキャラ</h3>
    @foreach (var id in notOwnedUnits) {
        <div style="display: flex;">
            <div>@(EventUnits.FirstOrDefault(x => x.Id == id).Name)</div>
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => RemoveNotOwnedUnit(id)"></button>
        </div>
    }
    <button @onclick="RemoveNotOwnedUnitAll" class="btn btn-primary mb-3">リセット</button>
}

@code {
    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    public List<string>? Suggest { get; set; }
    public List<PQEventUnit>? RemoveAddedUnits;
    public List<PQEventUnit>? EventUnits;

    AutoCompleteInput? AutoCompleteInput;
    PQPlayerUnit? Unit;
    List<PQAbility>? AllAbilities;

    List<PQPlayerUnit>? PQPlayerUnits;

    List<SateiCalculator.SateiInfo> sateiInfos = new();
    double steiScore = 0;

    bool isSubPosition = false;
    bool isBench = false;
    bool isJukuren = false;
    bool isCalucSatei = false;

    bool isPitcherMax = false;
    bool isFielderMax = false;


    int SelectedSubpos { get; set; } = 0;

    List<int> SelectJukurenIndexes = new() { };
    List<Jukuren> JukurenInfos = new(){
        //熟練の打撃
        //熟練の走塁
        //熟練の守備
        //熟練の投手
        new Jukuren(new UnitFielderStatus(0, 0, 7, 7, 0, 0, 0, 0),Jukuren.JukurenType.Dageki,1),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 10, 0, 0, 0),Jukuren.JukurenType.Run,1),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 0, 6, 6, 6),Jukuren.JukurenType.Shubi,1),
        new Jukuren(new UnitPitcherStatus(0, 6, 6, 6),Jukuren.JukurenType.Pitcher,1),

        new Jukuren(new UnitFielderStatus(0, 0, 9, 9, 0, 0, 0, 0),Jukuren.JukurenType.Dageki,2),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 15, 0, 0, 0),Jukuren.JukurenType.Run,2),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 0, 8, 8, 8),Jukuren.JukurenType.Shubi,2),
        new Jukuren(new UnitPitcherStatus(0, 8, 8, 8),Jukuren.JukurenType.Pitcher,2),

        new Jukuren(new UnitFielderStatus(0, 0,11,11, 0, 0, 0, 0),Jukuren.JukurenType.Dageki,3),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 20, 0, 0, 0),Jukuren.JukurenType.Run,3),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 0,10,10,10),Jukuren.JukurenType.Shubi,3),
        new Jukuren(new UnitPitcherStatus(0,10,10,10),Jukuren.JukurenType.Pitcher,3),

        new Jukuren(new UnitFielderStatus(0, 0,13,13, 0, 0, 0, 0),Jukuren.JukurenType.Dageki,4),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 25, 0, 0, 0),Jukuren.JukurenType.Run,4),
        new Jukuren(new UnitFielderStatus(0, 0, 0, 0, 0,12,12,12),Jukuren.JukurenType.Shubi,4),
        new Jukuren(new UnitPitcherStatus(0,12,12,12),Jukuren.JukurenType.Pitcher,4),
    };
    public class Jukuren {
        public enum JukurenType {
            Dageki = 0,
            Run = 1,
            Shubi = 2,
            Pitcher = 3,
        }
        public UnitFielderStatus UnitFielderStatus { get; set; }
        public UnitPitcherStatus UnitPitcherStatus { get; set; }
        public JukurenType Type { get; set; }
        public int Level { get; set; }
        public string Name { get { return $"{names[(int)Type]}{Level}"; } }
        string[] names = new string[4] { "打撃", "走塁", "守備", "投球"};

        public Jukuren(UnitFielderStatus unitStatus, JukurenType type, int level) {
            Type = type;
            Level = level;
            UnitFielderStatus = unitStatus;
            UnitPitcherStatus = new(0, 0, 0, 0);
        }
        public Jukuren(UnitPitcherStatus unitStatus, JukurenType type, int level) {
            Type = type;
            Level = level;
            UnitFielderStatus = new(0, 0, 0, 0, 0, 0, 0, 0);
            UnitPitcherStatus = unitStatus;
        }
    }

    HashSet<int> notOwnedUnits = new();
    private void AddNotOwnedUnit(int id) {
        notOwnedUnits.Add(id);
        SetLastDeck();
        CaluculateCoach();
    }
    private void RemoveNotOwnedUnit(int id) {
        notOwnedUnits.Remove(id);
        SetLastDeck();
        CaluculateCoach();
    }
    private void RemoveNotOwnedUnitAll() {
        notOwnedUnits = new();
        SetLastDeck();
        CaluculateCoach();
    }
    //ローカルストレージから取得
    public async Task LoadLastDeck() {
        try {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "notOwnUnit");

            if (!string.IsNullOrEmpty(json)) {
                notOwnedUnits = JsonSerializer.Deserialize<int[]>(json)?.ToHashSet() ?? new HashSet<int>();
            }
            else {
                notOwnedUnits = new HashSet<int>();
            }
        }
        catch (Exception ex) {
            // エラーハンドリング
            Console.WriteLine($"Error loading data from localStorage: {ex.Message}");
            notOwnedUnits = new HashSet<int>();  // 失敗した場合もデフォルト値を設定
        }
    }
    //ローカルストレージに保存
    private async Task SetLastDeck() {
        await JSRuntime.InvokeVoidAsync(
            "localStorage.setItem",
            "notOwnUnit",
            JsonSerializer.Serialize(
                notOwnedUnits.ToArray()
        )
        );
    }
    const int DECK_MAX_COUNT = 9;
    List<Deck>? decks;
    List<List<PQAbility>>? deckAbilites = new();

    int Level { get; set; } = 50;
    UnitFielderStatus InputStatus = new(0, 0, 50, 50, 50, 50, 50, 50);
    UnitFielderStatus DeckLimit = new(0, 0, 0, 0, 0, 0, 0, 0);

    UnitPitcherStatus InputPitcherStatus = new(0, 120, 50, 50);
    UnitPitcherStatus DeckPitcherLimit = new(0, 0, 0, 0);

    int CoarchCount = 4;

    int CalucMode = 1;
    private void OnRadioChange(string newValue) {
        int ValueInt = int.Parse(newValue);
        CalucMode = ValueInt;
    }

    protected override async Task OnInitializedAsync() {
        EventUnits = await Http.GetFromJsonAsync<List<PQEventUnit>>("json/eventUnit.json");
        PQPlayerUnits = await Http.GetFromJsonAsync<List<PQPlayerUnit>>($"json/playerUnit.json");
        AllAbilities = await Http.GetFromJsonAsync<List<PQAbility>>($"json/satei.json");

        Suggest = PQPlayerUnits?.Where(x => x.Position != 0).OrderByDescending(x => x.Id).Select(u => u.Name).ToList();
        InputStatus = new(0, 0, 50, 50, 50, 50, 50, 50);
        InputPitcherStatus = new(0, 120, 50, 50);
        await LoadLastDeck();
    }

    public async Task CaluculateCoach() {
        if (Unit == null) { return; }
        //とりあえず野手
        var canLearnAbilitys = AllAbilities.Where(x => x.PlayerType == 1).ToList();
        //投手
        if (Unit.Position == 1) {
            canLearnAbilitys = AllAbilities.Where(x => x.PlayerType == 2).ToList();
        }
        decks = new();
        deckAbilites = new();

        var limit = CalucDeckLmit(null);
        DeckLimit = limit.fLimit;//new(0, 0, 0, 0, 0, 0, 0, 0);
        DeckPitcherLimit = limit.pLimit;//new(0, 0, 0, 0);

        if (CoarchCount == 0) { return; }

        //所持している能力、同時取得できないを消す
        canLearnAbilitys = await RemoveOwnedAbilities(canLearnAbilitys);
        canLearnAbilitys = RemoveNonConcurrentAbilities(canLearnAbilitys);
        //ポジションに応じて能力を消す
        canLearnAbilitys = await RemovePositionSpecificAbilities(canLearnAbilitys);
        //下位込みの査定を計算
        canLearnAbilitys = SateiCalculator.SumLowRankSatei(canLearnAbilitys);
        //赤特を持っている場合は、上位の青特を削除する。
        canLearnAbilitys = await RemoveBlueIfHaveRed(canLearnAbilitys);
        //もってないキャラを除外
        RemoveAddedUnits = await RemoveNotOwnEventUnit();
        canLearnAbilitys = canLearnAbilitys.OrderByDescending(s => isBench ? s.SateiSub : s.SateiMain).ToList();
        //金徳入れる
        canLearnAbilitys = await AddGoldAbility(canLearnAbilitys);
        canLearnAbilitys = RemoveNonConcurrentAbilities(canLearnAbilitys);
        //威圧感
        canLearnAbilitys = await AddIatsukan(canLearnAbilitys);
        //能力上限を計算
        await CaluculateLimitCoachMode2();

        //deckAbilitesの中の金特を除外
        canLearnAbilitys = RemoveDeckAbilities(canLearnAbilitys);
        //青特を高い順でで取る
        await AddBlueAbility(canLearnAbilitys);   
    }
    public async Task<List<PQAbility>> AddGoldAbility(List<PQAbility> canLearnAbilitys) {
        //金徳入れる
        int skipCount = 0;
        int addCount = 0;
        for (int i = 0; i < CoarchCount; i++) {
            List<PQAbility> abilitys = new();
            addCount = 0;
            for (int k = 0; 2 > addCount; k++) {
                var ability = canLearnAbilitys.Skip(skipCount).First();
                skipCount++;
                RemoveAddedUnits = BalancedOrder(RemoveAddedUnits, 0).ToList();
                var unit = RemoveAddedUnits.FirstOrDefault(x => x.Abilities.Any(a => a.Id == ability.Id));
                if (unit == null) {
                    continue;
                }
                addCount++;
                decks.Add(new(unit, ability, i));
                abilitys.Add(ability);
            }
            deckAbilites.Add(abilitys);
        }
        return canLearnAbilitys;
    }

    public async Task<List<PQAbility>> AddIatsukan(List<PQAbility> canLearnAbilitys) {
        //威圧感を入れる
        //すでに入れたUnitは除外する
        var unitPool = RemoveAddedUnits.Where(u => !decks.Select(x => x.unit).Any(d => d.Id == u.Id));
        PQAbility iatukan = canLearnAbilitys.FirstOrDefault(s => s.Name.Contains("威圧感"));
        if (iatukan == null) return canLearnAbilitys;
        var havingIatukanUnit = unitPool?.FirstOrDefault(x => x.Abilities.Any(a => a.Id == iatukan.Id));
        if (havingIatukanUnit != null) {
            decks.Add(new(havingIatukanUnit, iatukan, 0));
            deckAbilites.First().Add(iatukan);
        }
        else {
            canLearnAbilitys = canLearnAbilitys.Where(x => !x.Name.Contains("威圧感")).ToList();
        }
        return canLearnAbilitys;
    }

    public async Task AddBlueAbility(List<PQAbility> canLearnAbilitys) {
        var OrderedBlueAbilities = canLearnAbilitys
        .Where(x => x.ColorType == 2)
        .GroupBy(a => a.GroupId)
        .Select(g => g.OrderByDescending(a => a.Rank).First())
        .OrderByDescending(x => isBench ? x.SateiSub : x.SateiMain)
        .ToList();
        for (int i = 0; i < CoarchCount; i++) {
            for (int k = 0; deckAbilites[i].Count < 5; k++) {
                var abilitiys = deckAbilites[i];
                var blueAbility = OrderedBlueAbilities.First();

                abilitiys.Add(blueAbility);
                OrderedBlueAbilities = RemoveNonConcurrentAbility(OrderedBlueAbilities, blueAbility);
                OrderedBlueAbilities = RemoveDeckAbilities(OrderedBlueAbilities);
            }
        }
    }

    public List<PQAbility> RemoveDeckAbilities(List<PQAbility> canLearnAbilitys) {
        List<PQAbility> aaa = deckAbilites.SelectMany(x => x).ToList();
