    public void GetUnitStatus() {
        if (AutoCompleteInput?.InputValue == null) { return; }
        Unit = null;
        Unit = PQPlayerUnits?.FirstOrDefault(u => u.Name == AutoCompleteInput?.InputValue);
        //Console.WriteLine(PQPlayerUnit.Name);

        float fieldDeclineRate = 1f;
        if (isSubPosition) {
            if (SelectedSubpos == 0) {
                fieldDeclineRate = 0.7f;
            }
            else if (SelectedSubpos == 1) {
                fieldDeclineRate = 0.8f;
            }
            else if (SelectedSubpos == 2) {
                fieldDeclineRate = 1f;
            }
        }

        if (Unit.Status != null) {
            int fieldTemp = CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.Fielding);

            InputStatus = new(0, 0,
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.Meet),
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.Power),
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.RunPower),
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.ShoulderPower),
            isSubPosition ? (int)Math.Floor(fieldTemp * fieldDeclineRate) : fieldTemp,
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.Status.Catching));
        }
        if (Unit.PitcherStatus != null) {
            InputPitcherStatus = new(0,
            100 + CoachCaluclator.CalucStatusFromLevel(Level, Unit.PitcherStatus.BallSpeed - 100),
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.PitcherStatus.BallControl),
            CoachCaluclator.CalucStatusFromLevel(Level, Unit.PitcherStatus.Stamina));
        }
        StateHasChanged();
    }
